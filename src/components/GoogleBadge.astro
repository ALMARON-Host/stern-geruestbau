---
import { contact } from '../data/site';

interface Props {
  variant?: 'card' | 'inline';
}
const { variant = 'card' } = Astro.props;
const score = contact.googleRating.toLocaleString('de-DE', { minimumFractionDigits: 1 });
---

<div class:list={['g-badge', variant]} role="img" aria-label={`Google-Bewertung: ${score} von 5 Sternen`}>
  <svg class="g-logo" viewBox="0 0 48 48" aria-hidden="true">
    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
  </svg>
  <div class="g-score">{score}</div>
  <div class="g-meta">
    <div class="g-stars" style={`--rating: ${contact.googleRating}`} aria-hidden="true"></div>
    <div class="g-label">Google-Bewertungen</div>
  </div>
</div>

<style>
  .g-badge {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 12px 20px 12px 14px;
    background: var(--white);
    color: var(--ink);
    border-radius: 10px;
  }
  .card {
    box-shadow: 0 14px 34px -14px rgb(0 0 0 / 0.55);
  }
  .inline {
    border: 1px solid var(--line);
  }
  .g-logo {
    width: 34px;
    height: 34px;
    flex: none;
  }
  .g-score {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 2.5rem;
    line-height: 1;
    padding-right: 14px;
    border-right: 1px solid var(--line);
  }
  .g-stars {
    --pct: calc(var(--rating) / 5 * 100%);
    font-size: 1.2rem;
    line-height: 1;
    letter-spacing: 0.08em;
    width: max-content;
    background: linear-gradient(90deg, #fbbc05 var(--pct), #d4d9df var(--pct));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .g-stars::before {
    content: '★★★★★';
  }
  .g-label {
    margin-top: 4px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
  }
</style>
