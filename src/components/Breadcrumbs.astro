---
import { url } from '../lib/url';

interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Brotkrümel-Navigation">
  <ol>
    {items.map((i, idx) => (
      <li>
        {i.href && idx < items.length - 1 ? <a href={url(i.href)}>{i.label}</a> : <span aria-current="page">{i.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    font-size: 0.92rem;
    color: rgb(255 255 255 / 0.75);
  }
  li + li::before {
    content: '›';
    margin: 0 10px;
    color: rgb(255 255 255 / 0.45);
  }
  a {
    text-decoration: none;
  }
  a:hover {
    color: var(--white);
    text-decoration: underline;
  }
  span[aria-current] {
    color: rgb(255 255 255 / 0.95);
  }
</style>
