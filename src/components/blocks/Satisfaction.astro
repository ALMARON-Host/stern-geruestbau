---
import { url, withBase, goodAlt } from '../../lib/url';
import GoogleBadge from '../GoogleBadge.astro';

interface Props {
  html: string;
  images?: { src: string; alt: string }[];
  alt: string;
}
const { html, images = [], alt } = Astro.props;
---

<section class="section satisfaction">
  <div class="wrap sat-grid">
    <div class="sat-text">
      <div class="prose prose-light" set:html={withBase(html)} />
      <GoogleBadge />
    </div>
    {images.length > 0 && (
      <div class:list={['sat-media', { duo: images.length > 1 }]}>
        {images.slice(0, 2).map((i) => (
          <img src={url(i.src)} alt={goodAlt(i.alt, alt)} loading="lazy" />
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .satisfaction {
    background: var(--navy);
    color: var(--white);
  }
  .sat-grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .sat-grid {
      grid-template-columns: 1fr 1.1fr;
      gap: 64px;
    }
  }
  .sat-text :global(p) {
    font-size: 1.3rem;
    line-height: 1.5;
  }
  .sat-text :global(.g-badge) {
    margin-top: 28px;
  }
  .sat-media {
    display: grid;
    gap: 14px;
  }
  .sat-media.duo {
    grid-template-columns: 1.4fr 1fr;
  }
  .sat-media img {
    width: 100%;
    height: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: 10px;
  }
</style>
