---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { nav, contact } from '../data/site';
import { url } from '../lib/url';

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (item: { href?: string; children?: { href: string }[] }) =>
  item.href === current || item.children?.some((c) => c.href === current);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href={url('/')} class="brand" aria-label="Stern Gerüstbau – zur Startseite">
      <Image src={logo} alt="Stern Gerüstbau & Verleih" width={640} widths={[320, 640]} sizes="(min-width: 1200px) 260px, 220px" loading="eager" />
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Hauptnavigation">
      <ul>
        {nav.map((item) => (
          <li class:list={[{ 'has-sub': item.children, active: isActive(item) }]}>
            {item.children ? (
              <>
                <button type="button" class="nav-link nav-toggle" aria-expanded="false">
                  {item.label}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" /></svg>
                </button>
                <ul class="sub">
                  {item.href && (
                    <li><a href={url(item.href)} class="sub-overview">{item.label} – Übersicht</a></li>
                  )}
                  {item.children.map((c) => (
                    <li><a href={url(c.href)} aria-current={c.href === current ? 'page' : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={url(item.href!)} class="nav-link" aria-current={item.href === current ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a href={contact.phoneHref} class="btn btn-navy header-call">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
      <span class="call-label">{contact.phone}</span>
    </a>

    <button type="button" class="menu-btn" aria-controls="main-nav" aria-expanded="false" aria-label="Menü öffnen">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const menuBtn = header?.querySelector<HTMLButtonElement>('.menu-btn');
  menuBtn?.addEventListener('click', () => {
    const open = menuBtn.getAttribute('aria-expanded') !== 'true';
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    header?.classList.toggle('menu-open', open);
    document.body.classList.toggle('no-scroll', open);
  });

  header?.querySelectorAll<HTMLButtonElement>('.nav-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      header.querySelectorAll('.nav-toggle').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      btn.setAttribute('aria-expanded', String(open));
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.has-sub')) {
      header?.querySelectorAll('.nav-toggle').forEach((b) => b.setAttribute('aria-expanded', 'false'));
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') header?.querySelectorAll('.nav-toggle').forEach((b) => b.setAttribute('aria-expanded', 'false'));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Solid background: a backdrop-filter here would clip the fixed mobile menu */
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 80px;
  }
  .brand {
    flex: none;
  }
  .brand img {
    width: 220px;
  }
  .header-call {
    margin-left: auto;
    min-height: 44px;
    padding: 0 14px;
  }
  .call-label {
    display: none;
  }

  /* Hamburger */
  .menu-btn {
    display: grid;
    gap: 5px;
    place-content: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    cursor: pointer;
  }
  .menu-btn span {
    width: 22px;
    height: 2.5px;
    background: var(--navy-dark);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .menu-open .menu-btn span:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  .menu-open .menu-btn span:nth-child(2) {
    opacity: 0;
  }
  .menu-open .menu-btn span:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  /* Mobile menu panel */
  .main-nav {
    display: none;
    position: fixed;
    inset: 80px 0 0;
    background: var(--white);
    overflow-y: auto;
    padding: 12px 16px 120px;
  }
  .menu-open .main-nav {
    display: block;
  }
  .main-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-nav > ul > li {
    border-bottom: 1px solid var(--line);
  }
  /* Top-level items: links and dropdown buttons look exactly the same */
  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    width: 100%;
    margin: 0;
    padding: 14px 4px;
    border: 0;
    background: none;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.2rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: left;
    color: var(--steel);
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }
  .nav-toggle svg {
    width: 16px;
    height: 16px;
    flex: none;
    transition: transform 0.2s;
  }
  .nav-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .nav-link:hover,
  .nav-link[aria-current='page'],
  .active > .nav-link {
    color: var(--navy);
  }
  .sub {
    display: none;
    padding: 0 0 10px 12px !important;
  }
  .nav-toggle[aria-expanded='true'] + .sub {
    display: block;
  }
  .sub a {
    display: block;
    font-family: var(--font-body);
    font-size: 1.02rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--steel);
    text-decoration: none;
    padding: 10px 4px;
  }
  .sub a:hover,
  .sub a[aria-current='page'] {
    color: var(--navy);
  }
  .sub-overview {
    color: var(--navy) !important;
  }

  @media (min-width: 640px) {
    .brand img {
      width: 250px;
    }
    .call-label {
      display: inline;
    }
    .header-call {
      padding: 0 18px;
    }
  }

  @media (min-width: 1200px) {
    .header-inner {
      min-height: 96px;
      gap: 24px;
    }
    .brand img {
      width: 260px;
    }
    .menu-btn {
      display: none;
    }
    .main-nav {
      display: block;
      position: static;
      padding: 0;
      overflow: visible;
      background: none;
      margin-left: auto;
    }
    .main-nav > ul {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .main-nav > ul > li {
      border: 0;
      position: relative;
    }
    .nav-link {
      width: auto;
      height: 44px;
      padding: 0 12px;
      font-size: 1.05rem;
      line-height: 1;
      gap: 5px;
    }
    /* Accent bar under the active / hovered item */
    .nav-link::after {
      content: '';
      position: absolute;
      left: 12px;
      right: 12px;
      bottom: 4px;
      height: 3px;
      border-radius: 2px;
      background: var(--accent);
      transform: scaleX(0);
      transition: transform 0.2s;
    }
    .nav-link:hover::after,
    .nav-link[aria-current='page']::after,
    .active > .nav-link::after {
      transform: scaleX(1);
    }
    .sub {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      min-width: 290px;
      padding: 10px !important;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 10px;
      box-shadow: var(--shadow);
    }
    .has-sub:hover .sub,
    .has-sub:focus-within .sub {
      display: block;
    }
    .sub::before {
      content: '';
      position: absolute;
      inset: -10px 0 auto;
      height: 10px;
    }
    .sub a {
      padding: 9px 12px;
      border-radius: 6px;
    }
    .sub a:hover {
      background: var(--paper);
    }
    .header-call {
      margin-left: 8px;
    }
  }
</style>
